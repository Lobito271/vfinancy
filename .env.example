# Copy to .env and adjust. All values here match the defaults in backend/infrastructure/config/config.go.

# --- App ---
APP_NAME=vfinancy
APP_ENV=development
APP_VERSION=0.0.0
APP_PORT=8787
APP_WINDOW_TITLE=vfinancy
APP_WIDTH=1280
APP_HEIGHT=800

# --- Database ---
# Driver: sqlite (local runtime) or postgres (cloud mirror / dev).
DB_DRIVER=sqlite
DB_PATH=data/vfinancy.db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=casa123
DB_NAME=vfinancy
DB_SSLMODE=disable
DB_MAX_OPEN=25
DB_MAX_IDLE=5
DB_MAX_LIFETIME_MIN=30
# Path is relative to the repo root.
DB_MIGRATION_DIR=backend/migrations/sqlite

# --- Logger ---
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# --- Auth (Argon2id) ---
AUTH_ARGON_MEMORY_KB=65536
AUTH_ARGON_ITERATIONS=3
AUTH_ARGON_PARALLELISM=2
AUTH_ARGON_SALT_LEN=16
AUTH_ARGON_KEY_LEN=32
AUTH_SESSION_TTL_MIN=60
AUTH_LOCKOUT_TTL_MIN=15
AUTH_MAX_LOGIN_ATTEMPTS=5

# --- Sync (cloud PostgreSQL mirror) ---
# Set SYNC_ENABLED=false to run fully offline.
SYNC_ENABLED=false
SYNC_SERVER_URL=
SYNC_API_KEY=
SYNC_POLL_INTERVAL_SEC=30
