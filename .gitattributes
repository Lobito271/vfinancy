###############################################################################
# Default behavior
###############################################################################

# Normalize text files and store them in Git with LF.
* text=auto eol=lf

###############################################################################
# Source code
###############################################################################

*.go          text
*.mod         text
*.sum         text

*.ts          text
*.tsx         text
*.js          text
*.jsx         text
*.mjs         text
*.cjs         text

*.json        text
*.jsonc       text

*.css         text
*.scss        text
*.sass        text
*.less        text

*.html        text
*.svg         text
*.xml         text
*.yml         text
*.yaml        text
*.toml        text

*.md          text
*.txt         text
*.sql         text

###############################################################################
# Shell scripts
###############################################################################

*.sh          text eol=lf

###############################################################################
# Windows scripts
###############################################################################

*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

###############################################################################
# Binary files
###############################################################################

*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.icns        binary

*.pdf         binary

*.zip         binary
*.gz          binary
*.tar         binary
*.7z          binary

*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary

*.exe         binary
*.dll         binary
*.so          binary
*.dylib       binary

*.db          binary
*.sqlite      binary
*.sqlite3     binary